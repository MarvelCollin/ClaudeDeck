{
  "name": "claudedeck",
  "version": "1.0.1",
  "description": "Switch the active Claude account across Claude Desktop and Claude Code, and schedule background Claude runs, from one local control panel.",
  "homepage": "https://github.com/MarvelCollin/ClaudeDeck#readme",
  "bugs": {
    "url": "https://github.com/MarvelCollin/ClaudeDeck/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarvelCollin/ClaudeDeck.git"
  },
  "license": "MIT",
  "author": "Marvel Collin",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "claudedeck": "bin/claudedeck.js",
    "cdeck": "bin/cdeck.js"
  },
  "files": [
    "bin",
    "scripts",
    "claudedeck.config.json",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "claude-desktop",
    "account-switcher",
    "session",
    "multi-account",
    "cron",
    "scheduler",
    "launchd",
    "automation"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node scripts/runner/run-claude.js",
    "login": "claude auth",
    "task": "node scripts/cli/task.js",
    "install-task": "node scripts/cli/task.js install",
    "check": "node scripts/dev/check.js",
    "test": "node --test tests/*.test.js",
    "prepublishOnly": "npm run check",
    "web": "node bin/claudedeck.js web"
  }
}
