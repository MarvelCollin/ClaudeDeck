{
  "name": "claudedeck-engine",
  "version": "1.0.1",
  "private": true,
  "description": "The engine the ClaudeDeck Claude Code mod runs: account switching, live usage, auto switch and background runs.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarvelCollin/ClaudeDeck.git"
  },
  "license": "MIT",
  "author": "Marvel Collin",
  "bin": {
    "claudedeck": "bin/claudedeck.js"
  },
  "engines": {
    "node": ">=18.19"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --project tsconfig.test.json",
    "dev": "tsx src/bin/claudedeck.ts",
    "web": "tsx src/bin/claudedeck.ts web",
    "start": "tsx src/bin/run-claude.ts",
    "check": "npm run typecheck && tsx src/dev/check.ts",
    "test": "node --import tsx --test tests/*.spec.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "claude",
    "claude-code",
    "claude-desktop",
    "account-switcher",
    "session",
    "multi-account",
    "cron",
    "scheduler",
    "launchd",
    "automation"
  ]
}
